# Compose project name, Traefik router/service name and host prefix.
# DNS label: [a-z0-9-], max 63 chars. The generator derives it from the run id
# and option, e.g. run_20261008_101500_ab12cd34 + op1 ->
# run-20261008-101500-ab12cd34-op1
APP_ID=run-20261008-101500-ab12cd34-op1

# Public host routed by the Traefik gateway (http://<APP_HOST>:3311).
# Docker Compose interpolates ${APP_ID} inside .env, so this follows APP_ID.
APP_HOST=${APP_ID}.localhost
