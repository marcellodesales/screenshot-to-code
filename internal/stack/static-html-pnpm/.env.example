# DNS label: lowercase [a-z0-9-], <= 63 chars. Also the compose project name
# and the Traefik router/service name.
# Derived from run id + option, e.g. run_20261008_101500_ab12cd34 + op1:
APP_ID=run-20261008-101500-ab12cd34-op1

# Host routed by the system gateway (Traefik, host port 3311). Defaults to
# ${APP_ID}.localhost; *.localhost resolves to 127.0.0.1 in browsers.
APP_HOST=run-20261008-101500-ab12cd34-op1.localhost
