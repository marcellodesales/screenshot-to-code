# syntax=docker/dockerfile:1.7
#
# Production image for a Next.js (App Router) app built with pnpm.
# Template: internal/stack/nextjs-react-tailwind-pnpm
#
# Stages:
#   base    - pinned Node runtime shared by every stage
#   deps    - pnpm (via corepack, pinned by package.json#packageManager) +
#             node_modules from the frozen lockfile, store in a BuildKit cache
#   builder - `next build` with `output: "standalone"`
#   runner  - only the standalone server, static assets and public/, non-root
#
# Build:  docker build -t <app>:latest .
# Run:    docker run --rm -p 127.0.0.1:3000:3000 <app>:latest

# Node 22 LTS on Alpine 3.24, pinned by tag AND multi-arch index digest so the
# build is reproducible; bump both together (`docker buildx imagetools inspect`).
ARG NODE_IMAGE=node:22.23.3-alpine3.24@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

# ---------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS base
# libc6-compat is intentionally NOT installed: next/swc, turbopack, lightningcss
# and tailwind oxide all ship linux-*-musl binaries, so no glibc shim is needed.
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

# ---------------------------------------------------------------------------
FROM base AS deps
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    COREPACK_HOME=/corepack
# Only the manifests: this layer (and the dependency install below) is reused
# until package.json / the lockfile / pnpm settings change.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Corepack reads "packageManager" from package.json, so the pnpm version used
# here is exactly the one the lockfile was produced with.
RUN corepack enable pnpm && corepack install
# Content-addressable store lives in a BuildKit cache mount: re-builds re-use
# downloaded tarballs, and the store never ends up in an image layer.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store

# ---------------------------------------------------------------------------
FROM deps AS builder
COPY . .
RUN pnpm build

# ---------------------------------------------------------------------------
FROM base AS runner

ARG APP_NAME=nextjs-app
ARG APP_VERSION=0.1.0
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="${APP_NAME}" \
      org.opencontainers.image.description="Next.js app generated by screenshot-to-code (stack: nextjs-react-tailwind-pnpm)" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.base.name="docker.io/library/node:22.23.3-alpine3.24" \
      org.opencontainers.image.licenses="UNLICENSED" \
      dev.screenshot-to-code.stack="nextjs-react-tailwind-pnpm"

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Fixed, numeric uid/gid so Kubernetes `runAsNonRoot` can verify it.
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 --ingroup nodejs --no-create-home nextjs

# Standalone output = minimal server.js + traced node_modules. Static assets
# and public/ are not part of it and must be copied next to it.
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER 1001:1001
EXPOSE 3000

# No curl/wget dependency: use Node's built-in fetch.
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

# Exec form: node is PID 1 and receives SIGTERM directly; the Next standalone
# server handles SIGTERM/SIGINT for graceful shutdown.
CMD ["node", "server.js"]
